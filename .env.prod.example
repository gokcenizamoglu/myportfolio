# Copy to .env.prod and fill in. .env.prod holds secrets and is gitignored.
#   cp .env.prod.example .env.prod

# Your domain, without protocol. DNS A/AAAA record must point to the VM's IP.
DOMAIN=portfolio.example.com

# Email for Let's Encrypt (expiry/renewal notices). Recommended.
ACME_EMAIL=you@example.com

# Long random secret used to derive anonymous daily analytics visitor IDs.
ANALYTICS_HASH_SECRET=replace-with-a-long-random-secret

# Google Gemini API key, used only by the admin CV-import feature.
# Leave blank if you don't use CV import.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Keep OpenAI search indexing enabled. GPTBot controls model-training crawling
# separately; set this to false if you prefer to disallow it.
GPTBOT_ALLOW=true

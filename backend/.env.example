PORT=8080
APP_ENV=development
DATABASE_PATH=./data/portfolio.db
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
# Use a long random value in production. It is used only to derive rotating,
# anonymous daily visitor identifiers and is never sent to clients.
ANALYTICS_HASH_SECRET=
# CV import via Gemini (optional). Leave GEMINI_API_KEY empty to disable the feature.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
